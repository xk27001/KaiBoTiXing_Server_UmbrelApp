# KaiBoTiXing 数据库配置示例（阿里云 RDS MySQL）
#
# 复制为 db.properties 后按实际环境修改：
#   src/main/resources/config/db.properties
#
# Umbrel 社区版把配置放在宿主机：
#   ~/umbrel/app-data/kaibotixing-server/data/config/db.properties
#
# 请勿把包含真实密码的 db.properties 提交到 Git。

# 阿里云 RDS 连接地址，例如 rm-xxxxxxxxxxxx.mysql.rds.aliyuncs.com
db.host=rm-xxxxxxxxxxxx.mysql.rds.aliyuncs.com
db.port=3306
db.database=kai_bo_ti_xing
db.username=kaibotixing
db.password=change-me

# 公网访问阿里云 RDS 时默认要求 SSL。若实例未开启 SSL，可改为：
# useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&sslMode=DISABLED&useSSL=false&allowPublicKeyRetrieval=true
db.params=useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&sslMode=REQUIRED&useSSL=true&requireSSL=true&allowPublicKeyRetrieval=false

# 阿里云 RDS 中建议预先创建数据库和账号，并关闭自动建库。
db.auto.create=false

# 代理池每轮采样验证条数和验证并发数（网页设置会持久化到 monitor_config）
crawler.proxy.validate.sample.count=250
crawler.proxy.validate.parallelism=200
crawler.proxy.refresh.minutes=40

# 无界面 Web 服务端
server.listen=0.0.0.0
server.port=8080
server.monitor.auto-start=true

# 每个页面最多请求次数（代理轮换 + 最后一次直连）
crawler.retry.count=15

# 代理验证目标：必须能返回正常抖音页面，验证码页会被拒绝
crawler.proxy.validate.url=https://live.douyin.com/
